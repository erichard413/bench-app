{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/example.json",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer"
    },
    "seasonId": {
      "type": "integer"
    },
    "jerseyNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "position": {
      "type": "string",
      "enum": ["RW", "LW", "C", "D", "G"]
    },
    "role": {
      "type": "string",
      "enum": ["captain", "player", "coach", "owner"]
    }
  },
  "additionalProperties": false,
  "required": ["userId", "seasonId", "jerseyNumber", "position"]
}
